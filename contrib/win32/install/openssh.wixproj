<Project Sdk="WixToolset.Sdk/6.0.2">
    <PropertyGroup>
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
        <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
        <OutputName>openssh</OutputName>
        <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
        <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
        <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <BindInputPaths Include="..\..\..\bin\$(Platform)\$(Configuration)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
        <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
        <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    </ItemGroup>
</Project>
